{
	admin off
	auto_https off
}

banystock.com, www.banystock.com {
	encode gzip

	tls /etc/letsencrypt/live/banystock.com/fullchain.pem /etc/letsencrypt/live/banystock.com/privkey.pem

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
	}

	reverse_proxy app:8000 {
		lb_policy round_robin
		health_uri /up
		health_interval 10s
		health_timeout 5s
	}
}

http://banystock.com, http://www.banystock.com {
	redir https://{host}{uri} permanent
}
